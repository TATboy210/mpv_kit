diff --git a/include/mpv/render_vk.h b/include/mpv/render_vk.h
index fff068c..34328cb 100644
--- a/include/mpv/render_vk.h
+++ b/include/mpv/render_vk.h
@@ -64,6 +64,10 @@ extern "C" {
  *    Better HDR/tone mapping and color management, persistent shader and
  *    ICC caches.
  *  - "gpu": mpv's older gl_video renderer, as used by --vo=gpu.
+ *
+ * Also valid for mpv_render_context_get_info(): data is a const char**
+ * that receives the active renderer ("gpu-next", "gpu" or "sw"). The string
+ * is static. Builds without this extension return MPV_ERROR_NOT_IMPLEMENTED.
  */
 #define MPV_RENDER_PARAM_VULKAN_RENDERER    ((mpv_render_param_type)0x6d6b0003)
 
diff --git a/video/out/vo_libmpv.c b/video/out/vo_libmpv.c
index e0d3afd..46c6b4a 100644
--- a/video/out/vo_libmpv.c
+++ b/video/out/vo_libmpv.c
@@ -28,6 +28,10 @@
 
 #include "libmpv.h"
 
+#if HAVE_VULKAN
+#include "mpv/render_vk.h"
+#endif
+
 #if HAVE_MACOS_COCOA_CB
 #include "osdep/mac/app_bridge.h"
 #endif
@@ -483,6 +487,19 @@ int mpv_render_context_get_info(mpv_render_context *ctx,
         res = 0;
         break;
     }
+#if HAVE_VULKAN
+    case MPV_RENDER_PARAM_VULKAN_RENDERER: {
+        // mpv_kit: which renderer the context was created with, so the API
+        // user can tell gpu-next from a fallback (or an older libmpv, which
+        // returns MPV_ERROR_NOT_IMPLEMENTED here).
+        const char **name = param.data;
+        const struct render_backend_fns *fns = ctx->renderer->fns;
+        *name = fns == &render_backend_gpu_next ? "gpu-next" :
+                fns == &render_backend_gpu ? "gpu" : "sw";
+        res = 0;
+        break;
+    }
+#endif
     default:;
     }
 
