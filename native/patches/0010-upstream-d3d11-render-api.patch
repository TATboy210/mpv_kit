diff --git a/include/mpv/render_d3d11.h b/include/mpv/render_d3d11.h
new file mode 100644
index 000000000..7fa4c12ce
--- /dev/null
+++ b/include/mpv/render_d3d11.h
@@ -0,0 +1,118 @@
+/* Copyright (C) 2024 the mpv developers
+ *
+ * Permission to use, copy, modify, and/or distribute this software for any
