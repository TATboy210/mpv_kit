diff --git a/video/out/gpu_next/libmpv_gpu_next.c b/video/out/gpu_next/libmpv_gpu_next.c
index 6914278bd..9e651daf8 100644
--- a/video/out/gpu_next/libmpv_gpu_next.c
+++ b/video/out/gpu_next/libmpv_gpu_next.c
@@ -23,6 +23,7 @@
 #include "video/out/gpu/context.h"
 #include "video/out/gpu/libmpv_gpu.h"
 #include "video/out/libmpv.h"
+#include "mpv/render_gl.h"
 
 struct priv {
     struct libmpv_gpu_context *context;
@@ -42,6 +43,23 @@ static int init(struct render_backend *ctx, mpv_render_param *params)
     if (err < 0)
         return err;
 
+    // mpv_kit: hand the host's DRM render node to hwdec (VA-API), like the
+    // gpu renderer's libmpv_gpu.c does for its native resources. hwdecs are
+    // loaded below (mppl_video_init_hwdecs, load_all), so the resource must
+    // sit on the ra before that, or hwdec_vaapi's create_drm_va_display()
+    // finds no render node. Only drm_params_v2 is registered: x11/wayland
+    // are disabled in mpv_kit builds and drm_draw_surface_size only serves
+    // the drmprime overlay (the host passes fd=-1, which skips it). The
+    // struct is copied like libmpv_gpu.c copies its entries.
+    mpv_opengl_drm_params_v2 *drm = get_mpv_render_param(
+        params, MPV_RENDER_PARAM_DRM_DISPLAY_V2, NULL);
+    if (drm) {
+        drm = talloc_memdup(ctx, drm, sizeof(*drm));
+        ra_add_native_resource(p->context->ra_ctx->ra, "drm_params_v2", drm);
+        MP_VERBOSE(ctx, "gpu-next: native resource drm_params_v2 (render_fd %d)\n",
+                   drm->render_fd);
+    }
+
     bool probing = !get_mpv_render_param(params, MPV_RENDER_PARAM_RENDERER, NULL);
     p->gpu_ctx = gpu_ctx_create(ctx->log, p->context->ra_ctx, probing);
     if (!p->gpu_ctx)
diff --git a/video/out/vo_libmpv.c b/video/out/vo_libmpv.c
index 39fae2cfe..436b57c9e 100644
--- a/video/out/vo_libmpv.c
+++ b/video/out/vo_libmpv.c
@@ -7,6 +7,7 @@
 #include <stdlib.h>
 #include <string.h>
 
+#include "config.h"
 #include "mpv_talloc.h"
 #include "common/common.h"
 #include "misc/bstr.h"
@@ -27,6 +28,10 @@
 
 #include "libmpv.h"
 
+#if HAVE_VULKAN
+#include "mpv/render_vk.h"
+#endif
+
 #if HAVE_MACOS_COCOA_CB
 #include "osdep/mac/app_bridge.h"
 #endif
@@ -493,6 +498,20 @@ int mpv_render_context_get_info(mpv_render_context *ctx,
         res = 0;
         break;
     }
+#if HAVE_VULKAN
+    case MPV_RENDER_PARAM_ACTIVE_RENDERER: {
+        // mpv_kit: which renderer the context was created with, so the API
+        // user can tell gpu-next from a fallback. Upstream logs the choice
+        // but does not expose it; an older libmpv returns
+        // MPV_ERROR_NOT_IMPLEMENTED here.
+        const char **name = param.data;
+        const struct render_backend_fns *fns = ctx->renderer->fns;
+        *name = fns == &render_backend_gpu_next ? "gpu-next" :
+                fns == &render_backend_gpu ? "gpu" : "sw";
+        res = 0;
+        break;
+    }
+#endif
     default:;
     }
 
