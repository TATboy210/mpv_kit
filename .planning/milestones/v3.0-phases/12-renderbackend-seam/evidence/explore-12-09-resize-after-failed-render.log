# ---- source: build/golden-local/p1209/scratch/explore_resize_after_failed_render.cc ----
// Scratch exploration (12-09, not a committed test): a resize while the
// previous resize has not produced a frame yet (the first new-size render
// failed). Does AcquireFront hand out an image that AllocateRing already
// destroyed?
#include <cstdio>
#include <memory>
#include <mutex>
#include <string>
#include <thread>
#include <vector>

#include "renderer_harness.h"

namespace {
using golden::Fake;
using golden::FakeInterop;
using golden::FakeVulkanInterop;
using golden::Images;
using mpv_kit::RendererChoice;
using mpv_kit::VideoRenderer;

std::mutex g_mu;
std::vector<std::string> g_log;

struct Rig {
  explicit Rig(int latency) : interop(latency, false, nullptr, &vk) {
    renderer = std::make_unique<VideoRenderer>(
        golden::MakeApi(), golden::FakeHandle(), &interop,
        [](const std::string& line) {
          std::lock_guard<std::mutex> lock(g_mu);
          g_log.push_back(line);
        },
        [](const char* kind, const std::string& msg) {
          Fake().Note(std::string("event ") + kind + " " + msg);
        });
  }
  FakeVulkanInterop vk;
  FakeInterop interop;
  std::unique_ptr<VideoRenderer> renderer;
};

void Acquire(Rig& rig, const char* when) {
  const mpv_kit::Frame f = rig.renderer->AcquireFront();
  const golden::FakeImage e = Images().Entry(f.platform);
  std::printf("%s: acquire index=%d %dx%d serial=%d%s\n", when, f.index,
              f.width, f.height, f.platform ? e.serial : 0,
              f.platform && e.destroyed ? " USE AFTER DESTROY" : "");
}

void Sync() {
  if (const uint64_t seq = Fake().Poke()) Fake().WaitPokeSeen(seq);
  for (const std::string& l : Fake().DrainAsync()) std::printf("  %s\n", l.c_str());
}
}  // namespace

int main() {
  std::setvbuf(stdout, nullptr, _IONBF, 0);
  Fake().Reset();
  Images().Reset();
  int rc = 0;
  {
    Rig rig(2);
    if (!rig.renderer->Start(RendererChoice::kGpuNext) ||
        rig.renderer->backend() != mpv_kit::Backend::kVulkan) {
      std::printf("SKIP: %s\n", rig.renderer->backend_reason().c_str());
      return 77;
    }
    std::printf("start: %s\n", rig.renderer->backend_reason().c_str());
    rig.renderer->SetSize(64, 36);
    rig.interop.WaitFrameReady(1);
    Sync();
    Acquire(rig, "64x36 frame 1");
    // The first render at the next size fails (mpv error), so no frame is
    // published at 32x18.
    Fake().SetRenderResults({-18});
    const int renders = Fake().counters().renders;
    rig.renderer->SetSize(32, 18);
    Fake().WaitRenders(renders + 1);
    Sync();
    Acquire(rig, "after failed 32x18 render");
    // Second resize before any 32x18 frame exists; hold its first render to
    // observe the reallocated-but-unpublished window.
    Fake().HoldRenders(true);
    rig.renderer->SetSize(48, 27);
    Fake().WaitRenderHeld();
    for (const std::string& l : Fake().DrainAsync()) std::printf("  %s\n", l.c_str());
    Acquire(rig, "during held 48x27 render");
    Fake().HoldRenders(false);
    std::this_thread::sleep_for(golden::Ms(100));
    Sync();
    Fake().SignalPending();
  }
  for (const std::string& v : Images().TakeViolations()) {
    std::printf("VIOLATION %s\n", v.c_str());
    rc = 1;
  }
  std::printf("live-images=%d\n", Images().live());
  for (const std::string& l : g_log) std::printf("log %s\n", l.c_str());
  return rc;
}
